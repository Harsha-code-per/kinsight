FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_MOCK=1
ARG NEXT_PUBLIC_FHIR_SANDBOX=0
ARG KINSIGHT_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_MOCK=$NEXT_PUBLIC_MOCK
ENV NEXT_PUBLIC_FHIR_SANDBOX=$NEXT_PUBLIC_FHIR_SANDBOX
ENV KINSIGHT_API_URL=$KINSIGHT_API_URL
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
